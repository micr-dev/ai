{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/ai/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/:path((?!assets|agents|skills|favicon-a.png|favicon-i.png|favicon.gif|favicon.png|og-image.png|robots.txt|sitemap.xml|index.css|main.js).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(favicon.gif|favicon.png|favicon-a.png|favicon-i.png|og-image.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/public/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
